# Docker Compose operator settings. Copy to .env and adjust paths as needed.
ATLAS_IMAGE=desalvo/atlas-install-server:latest
ATLAS_BIND_ADDRESS=0.0.0.0
ATLAS_HTTPS_PORT=8443
ATLAS_CRL_REFRESH_SECONDS=21600
ATLAS_TLS_CERT_SOURCE=./secrets/tls.crt
ATLAS_TLS_KEY_SOURCE=./secrets/tls.key
ATLAS_BOOTSTRAP_ENV_SOURCE=./secrets/atlas-install.env
