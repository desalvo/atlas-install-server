# Example only. The installer creates /etc/atlas-install/atlas-install.env.
# The real file contains secrets and is installed as root:atlas-install 0640.
ATLAS_PUBLIC_HOSTNAME="atlas-install-el10.apps.desalvo.eu"
ATLAS_DB_NAME="atlas_install_panda"
ATLAS_DB_RW_HOST="192.168.1.145"
ATLAS_DB_RW_USER="atlas_rw"
ATLAS_DB_RW_PASSWORD="CHANGE_ME"
ATLAS_DB_RO_HOST="192.168.1.145"
ATLAS_DB_RO_USER="atlas_ro"
ATLAS_DB_RO_PASSWORD="CHANGE_ME"
ATLAS_DB_BROKER_HOST="192.168.1.145"
ATLAS_DB_BROKER_USER="atlas_rw"
ATLAS_DB_BROKER_PASSWORD="CHANGE_ME"
ATLAS_DB_GRANT_HOST="192.168.1.144"
ATLAS_HOST_CERT_SOURCE="/etc/letsencrypt/live/apps.desalvo.eu/fullchain.pem"
ATLAS_HOST_KEY_SOURCE="/etc/letsencrypt/live/apps.desalvo.eu/privkey.pem"
ATLAS_HOST_CERT="/etc/pki/tls/certs/atlas-install.crt"
ATLAS_HOST_KEY="/etc/pki/tls/private/atlas-install.key"
ATLAS_UPLOAD_PATH="/var/lib/atlas-install/log"
ATLAS_ARCHIVE_PATH="/var/lib/atlas-install/logbackup"
ATLAS_CACHE_PATH="/var/cache/atlas-install"
ATLAS_KML_CACHE="/var/cache/atlas-install/install.kml"
ATLAS_DEBUG="0"
ATLAS_MAX_LOG_DIRS="4"
