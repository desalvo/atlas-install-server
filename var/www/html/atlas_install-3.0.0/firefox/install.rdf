<?xml version="1.0"?>

<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:em="http://www.mozilla.org/2004/em-rdf#">

	<Description about="urn:mozilla:install-manifest">
        <em:id>atlassw@roma1.infn.it</em:id>

	<!-- Basic info -->
	<em:name>ATLAS software installer</em:name>
	<em:version>1.0</em:version>
	<em:description>ATLAS software installation handler</em:description>
	<em:creator>Alessandro De Salvo Peter</em:creator>

	<!-- Tell Mozilla/Firefox where the JAR is -->
	<em:file>
		<Description about="urn:mozilla:extension:file:atlassw.jar">
			<em:package>content/atlassw/</em:package>
			<em:skin>skin/classic/atlassw/</em:skin>
		</Description>
	</em:file>

	<!-- Install in Firefox ver. 2.0 to 3.0 -->
	<em:targetApplication>
		<Description>
			<em:id>{ec8030f7-c20a-464f-9b0e-13a3a9e97384}</em:id>
			<em:minVersion>1.5</em:minVersion>
			<em:maxVersion>3.0.*</em:maxVersion>
		</Description>
	</em:targetApplication>

	<!-- URLs -->
	<em:homepageURL>http://atlas-install.roma1.infn.it/atlas_install/firefox</em:homepageURL>
	<em:optionsURL>chrome://atlassw/content/atlasswOptions.xul</em:optionsURL>
        <em:aboutURL>chrome://atlassw/content/about.xul</em:aboutURL>
        <em:iconURL>chrome://atlassw/skin/icon_small.png</em:iconURL>
        <em:updateURL>https://atlas-install.roma1.infn.it/atlas_install/firefox/update.rdf</em:updateURL>
	
	</Description>

</RDF>
