#!/usr/bin/bash
set -euo pipefail
umask 027

ENV_FILE="${ATLAS_ENV_FILE:-/etc/atlas-install/atlas-install.env}"
ini_get() {
  local key="$1" default="${2:-}"
  if [[ ! -r "$ENV_FILE" ]]; then printf '%s' "$default"; return; fi
  /usr/bin/php -r '$f=$argv[1];$k=$argv[2];$d=$argv[3];$a=parse_ini_file($f,false,INI_SCANNER_RAW)?:[];echo isset($a[$k])&&$a[$k]!==""?$a[$k]:$d;' "$ENV_FILE" "$key" "$default"
}

UPLOAD_PATH="$(ini_get ATLAS_UPLOAD_PATH /var/lib/atlas-install/log)"
ARCHIVE_PATH="$(ini_get ATLAS_ARCHIVE_PATH /var/lib/atlas-install/logbackup)"
MAXLOGDIRS="$(ini_get ATLAS_MAX_LOG_DIRS 4)"
DEBUG="$(ini_get ATLAS_DEBUG 0)"

UPLOAD_PATH="${UPLOAD_PATH%/}"
ARCHIVE_PATH="${ARCHIVE_PATH%/}"
[[ -n "$ARCHIVE_PATH" && "$UPLOAD_PATH" != "$ARCHIVE_PATH" ]] || exit 0
[[ "$MAXLOGDIRS" =~ ^[0-9]+$ ]] || { echo "Invalid ATLAS_MAX_LOG_DIRS" >&2; exit 2; }
[[ -d "$UPLOAD_PATH" && -d "$ARCHIVE_PATH" ]] || exit 0
mountpoint -q "$ARCHIVE_PATH" || { [[ "$DEBUG" == 1 ]] && echo "$ARCHIVE_PATH is not a mount point"; exit 0; }

mapfile -d '' dirs < <(find "$UPLOAD_PATH" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
total=${#dirs[@]}
(( total > MAXLOGDIRS )) || exit 0
move_count=$((total - MAXLOGDIRS))

for ((i=0; i<move_count; i++)); do
  src="${dirs[$i]}"
  name="$(basename -- "$src")"
  dest="$ARCHIVE_PATH/$name"
  [[ -e "$dest" ]] && { echo "Destination already exists: $dest" >&2; continue; }
  rsync -a --protect-args -- "$src/" "$dest/"
  rm -rf --one-file-system -- "$src"
  ln -s -- "$dest" "$UPLOAD_PATH/$name"
done
