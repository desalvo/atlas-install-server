Listen @HTTPS_PORT@ https
ServerName @PUBLIC_HOSTNAME@
ServerSignature Off
TraceEnable Off

<VirtualHost _default_:@HTTPS_PORT@>
  ServerName @PUBLIC_HOSTNAME@
  DocumentRoot "/var/www/html"

  # The public entrypoint is the ATLAS Installation application.
  RedirectMatch 302 ^/$ /atlas_install/

  SSLEngine on
  SSLCertificateFile    "@HOST_CERT@"
  SSLCertificateKeyFile "@HOST_KEY@"

  # Preserve the historical split: public areas remain public, while
  # /protected requires a successfully verified IGTF client certificate.
  SSLVerifyClient optional
  SSLVerifyDepth 20
  SSLCACertificatePath "/etc/grid-security/certificates"
  SSLCARevocationPath "/etc/grid-security/certificates"
  SSLCARevocationCheck chain
  SSLProtocol -all +TLSv1.2 +TLSv1.3
  SSLOptions +StdEnvVars +ExportCertData

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  <Directory "/var/www/html/atlas_install">
    Options -Indexes -ExecCGI
    AllowOverride None
    Require all granted
  </Directory>

  <Directory "/var/www/html/atlas_install/conf">
    Require all denied
  </Directory>

  <FilesMatch "(^\\.|\\.(?:sql|template|save|bak|orig|ini|env|log)$)">
    Require all denied
  </FilesMatch>

  <LocationMatch "^/atlas_install/protected(?:/|$)">
    Require expr "%{SSL_CLIENT_VERIFY} == 'SUCCESS'"
  </LocationMatch>

  ErrorLog  "/proc/self/fd/2"
  CustomLog "/proc/self/fd/1" combined
</VirtualHost>
